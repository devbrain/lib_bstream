PROJECT_NAME           = "bstream"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "C++20 binary streams, byte order, and bit I/O"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/reference"
INPUT                  = "@PROJECT_SOURCE_DIR@/include/bstream" "@CMAKE_CURRENT_SOURCE_DIR@/guide.dox"
FILE_PATTERNS          = *.hh *.dox
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */detail/*
EXCLUDE_SYMBOLS        = bstream::detail bstream::detail::*
EXAMPLE_PATH           = "@CMAKE_CURRENT_SOURCE_DIR@/examples"
EXAMPLE_PATTERNS       = *.cc
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@/include" "@PROJECT_SOURCE_DIR@"
FULL_PATH_NAMES        = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
HTML_DYNAMIC_SECTIONS  = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = "@CMAKE_CURRENT_BINARY_DIR@/doxygen-warnings.log"
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = NO
# Document optional APIs regardless of the local dependency configuration.
PREDEFINED             = BSTREAM_HAS_FAILSAFE=1 BSTREAM_HAS_PFR=1 BSTREAM_WITH_BOOST_PFR=1
